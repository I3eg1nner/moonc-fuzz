// Compiler-driven reduction driver.
//
// The pure engine lives in `reduce/`; the staging primitives live in
// `stager/`.  This file is only the loop that connects them, which is why it
// is short enough to audit in one sitting.
//
// Usage:
//   minimize --dir PATH [--file lib.mbt] [--stage build|check|test]
//            [--timeout-ms N] [--fuel N] [--out PATH] [--target native]
//            [--keep-workdir]
//
// Output: one JSON line. Exit 0 = reduced and re-verified, 1 = baseline is not
// a failure (nothing to reduce) or verification failed, 2 = bad usage.

import {
  "moonbitlang/core/async",
  "moonbitlang/core/env",
  "moonbitlang/x/fs",
  "I3eg1nner/mbtfuzz/reduce",
  "I3eg1nner/mbtfuzz/stager",
}

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
)

pkgtype(kind: "executable")
